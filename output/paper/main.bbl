      \field{labelnamesource}{author}
      \field{labeltitlesource}{title}
      \field{abstract}{This paper proposes to estimate the covariance matrix of stock returns by an optimally weighted average of two existing estimators: the sample covariance matrix and single-index covariance matrix. This method is generally known as shrinkage, and it is standard in decision theory and in empirical Bayesian statistics. Our shrinkage estimator can be seen as a way to account for extra-market covariance without having to specify an arbitrary multifactor structure. For NYSE and AMEX stock returns from 1972 to 1995, it can be used to select portfolios with significantly lower out-of-sample variance than a set of existing estimators, including multifactor models.}
      \field{issn}{0927-5398}
      \field{journaltitle}{Journal of Empirical Finance}
      \field{number}{5}
      \field{title}{Improved estimation of the covariance matrix of stock returns with an application to portfolio selection}
      \field{volume}{10}
      \field{year}{2003}
      \field{pages}{603\bibrangedash 621}
      \range{pages}{19}
